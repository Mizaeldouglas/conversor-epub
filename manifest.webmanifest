{
  "name": "Lombada: PDF para EPUB",
  "short_name": "Lombada",
  "description": "Converte PDF, DOCX, MOBI e outros formatos em EPUB para o Kindle, com capítulos, sumário e o texto conferido palavra por palavra. A conversão é feita no navegador.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f1f2f6",
  "theme_color": "#2536c7",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/epub+zip",
            ".epub",
            ".docx",
            ".txt",
            ".html",
            ".md",
            ".fb2",
            ".mobi",
            ".azw3",
            ".cbz"
          ]
        }
      ]
    }
  },
  "id": "./",
  "categories": [
    "books",
    "productivity",
    "utilities"
  ],
  "screenshots": [
    {
      "src": "docs/tela.png",
      "sizes": "1280x860",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Livro convertido, conferido e pronto para o Kindle"
    },
    {
      "src": "docs/previa.png",
      "sizes": "1280x860",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Prévia do EPUB com o sumário"
    },
    {
      "src": "docs/celular.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Lombada no celular"
    }
  ]
}
