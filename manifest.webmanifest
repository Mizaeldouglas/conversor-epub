{
  "name": "Lombada: PDF para EPUB",
  "short_name": "Lombada",
  "description": "Converte PDF em EPUB para o Kindle, no próprio navegador.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f1f2f6",
  "theme_color": "#2536c7",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "files": [{ "name": "arquivos", "accept": ["application/pdf", ".pdf", "application/epub+zip", ".epub"] }]
    }
  }
}
